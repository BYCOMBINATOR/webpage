---
import { pagePath, withBase } from "../lib/paths";
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = pagePath(Astro.url.pathname);

const links = [
  { href: withBase("/mesa"), label: "Mesa" },
  { href: withBase("/para-quien"), label: "Para quién" },
  { href: withBase("/batch"), label: "Batch" },
  { href: withBase("/glosa"), label: "Glosa" },
];
---

<header class="site-header">
  <a class="site-brand" href={withBase("/")} aria-current={path === "/" ? "page" : undefined}>
    <BrandMark />
  </a>
  <nav class="mono" aria-label="Sitio">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <ThemeToggle />
    <a
      class="cut header-cta"
      href={withBase("/lista")}
      aria-current={path === "/lista" ? "page" : undefined}>Anótate</a
    >
  </nav>
</header>
