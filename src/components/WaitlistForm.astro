---
import { withBase } from "../lib/paths";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const thanks = new URL(withBase("/gracias"), Astro.url.origin).href;
---

<form
  class="form"
  id="waitlist"
  method="POST"
  action="https://formsubmit.co/juliocesarsevericheorellana@gmail.com"
>
  <input type="hidden" name="_next" value={thanks} />
  <input type="hidden" name="_subject" value="BYC — lista de espera" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_template" value="table" />
  <p class="hp" aria-hidden="true">
    <label>Company <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </p>
  <label>
    Correo
    <input
      type="email"
      name="email"
      required
      placeholder="tu@proyecto.com"
      autocomplete="email"
    />
  </label>
  {
    compact ? null : (
      <label>
        Nombre
        <input type="text" name="name" placeholder="Opcional" autocomplete="name" />
      </label>
    )
  }
  <label>
    Quién eres
    <select name="rol">
      <option value="founder">Fundador o fundadora</option>
      <option value="guia">Guía o mentor</option>
      <option value="otro">Otra cosa</option>
    </select>
  </label>
  <button class="cut" type="submit">Avísame cuando abra la mesa</button>
</form>
