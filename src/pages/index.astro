---
import WaitlistForm from "../components/WaitlistForm.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="BYC — una nueva comunidad se acerca"
  description="Una nueva comunidad se acerca. Founders de Bolivia y la diáspora. Anotate a la lista."
>
  <section class="hero">
    <img class="hero-mark" src="/logos/byc-neg.svg" alt="BYC" />
    <p class="kicker mono">BYC</p>
    <h1>Una nueva comunidad se acerca.</h1>
    <p class="sub">
      Founders de Bolivia y la diáspora. La mesa, no el hall. Cuando abra,
      avisamos acá.
    </p>
    <WaitlistForm />
  </section>
</Base>
