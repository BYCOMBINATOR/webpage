---
import Marca from "../../components/comunica/Marca.astro";
import Perfiles from "../../components/comunica/Perfiles.astro";
import Swag from "../../components/comunica/Swag.astro";
import Base from "../../layouts/Base.astro";
import "../../styles/kit.css";
---

<Base
  title="BYC — comunicación"
  description="Cómo se usa BYC. Marca, swag, perfiles. El cubo no es la comunidad."
>
  <section class="hero">
    <p class="kicker mono">Comunicación</p>
    <h1>El cubo no es la comunidad.</h1>
    <p class="sub">
      Marca primero: dónde sí y dónde no. Después merch. Después cómo se ve el
      perfil. Diario: <strong>BYC</strong>. Ceremonial:
      <strong>BY-COMBINATOR</strong>.
    </p>
  </section>

  <nav class="tabs mono" role="tablist" aria-label="Comunicación">
    <a
      href="#marca"
      id="tab-marca"
      role="tab"
      data-tab="marca"
      aria-controls="marca"
      aria-selected="true">Marca</a
    >
    <a
      href="#swag"
      id="tab-swag"
      role="tab"
      data-tab="swag"
      aria-controls="swag"
      aria-selected="false">Swag</a
    >
    <a
      href="#perfiles"
      id="tab-perfiles"
      role="tab"
      data-tab="perfiles"
      aria-controls="perfiles"
      aria-selected="false">Perfiles</a
    >
  </nav>

  <div class="tab-panels">
    <div
      id="marca"
      role="tabpanel"
      data-panel="marca"
      aria-labelledby="tab-marca"
    >
      <Marca />
    </div>
    <div
      id="swag"
      role="tabpanel"
      data-panel="swag"
      aria-labelledby="tab-swag"
      hidden
    >
      <Swag />
    </div>
    <div
      id="perfiles"
      role="tabpanel"
      data-panel="perfiles"
      aria-labelledby="tab-perfiles"
      hidden
    >
      <Perfiles />
    </div>
  </div>

  <section class="salt section">
    <p class="kicker mono">Lista</p>
    <h2>La comunidad todavía no abrió.</h2>
    <p>
      Si llegaste por una collab, el kit está en Marca. Si quieres la mesa, la
      lista está en /lista.
    </p>
    <p style="margin-top: 1.2rem">
      <a class="cut" href="/lista">Anótate</a>
    </p>
  </section>
</Base>

<script>
  const TABS = new Set(["marca", "swag", "perfiles"]);

  function tabFromHash() {
    const id = location.hash.replace("#", "");
    if (TABS.has(id)) return id;
    return "marca";
  }

  function measureChrome() {
    const header = document.querySelector(".site-header");
    const tabs = document.querySelector(".tabs");
    if (header instanceof HTMLElement) {
      document.documentElement.style.setProperty(
        "--header-h",
        `${Math.round(header.getBoundingClientRect().height)}px`,
      );
    }
    if (tabs instanceof HTMLElement) {
      document.documentElement.style.setProperty(
        "--tabs-h",
        `${Math.round(tabs.getBoundingClientRect().height)}px`,
      );
    }
  }

  function apply(scroll = false) {
    const tab = tabFromHash();
    document.querySelectorAll("[data-panel]").forEach((el) => {
      const on = el.getAttribute("data-panel") === tab;
      (el as HTMLElement).hidden = !on;
    });
    document.querySelectorAll("[data-tab]").forEach((el) => {
      const on = el.getAttribute("data-tab") === tab;
      el.setAttribute("aria-selected", String(on));
    });
    if (scroll && TABS.has(location.hash.replace("#", ""))) {
      const tabs = document.querySelector(".tabs");
      const headerH =
        parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue(
            "--header-h",
          ),
        ) || 56;
      if (tabs instanceof HTMLElement) {
        window.scrollTo({ top: Math.max(0, tabs.offsetTop - headerH) });
      }
    }
    measureChrome();
    syncRail();
  }

  function syncRail() {
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>(".kit-nav a[href^='#']"),
    ];
    if (!links.length) return;
    const headerH =
      parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue(
          "--header-h",
        ),
      ) || 56;
    const tabsH =
      parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--tabs-h"),
      ) || 48;
    const line = headerH + tabsH + 24;
    let current = links[0];
    for (const link of links) {
      const target = document.querySelector(link.hash);
      if (
        target instanceof HTMLElement &&
        target.getBoundingClientRect().top <= line
      ) {
        current = link;
      }
    }
    links.forEach((link) => {
      const on = link === current;
      link.classList.toggle("is-active", on);
      if (on) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });
    const now = document.querySelector("[data-kit-now]");
    const label = current.querySelector(".kit-pip-label");
    if (now && label) now.textContent = label.textContent?.trim() || "";
  }

  apply(false);
  addEventListener("hashchange", () => apply(true));
  addEventListener("scroll", syncRail, { passive: true });
  addEventListener("resize", measureChrome);
  measureChrome();
</script>
